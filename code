  method categoria(){
    if (antiguedad >= 10){
      categoria = categoria.base()
    }
    return categoria
  }
  method importe(){
    if (tipo = electrico){
      importe = AutoElectrico.importe()
    }
    else if (tipo = naftero){
      importe = AutoNaftero.importe()
    }
    else if (tipo = agas){
      importe = AutoaGas.importe()
    }
  }
}

